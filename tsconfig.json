{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*", "utils/**/*", "pages/**/*", "helpers/**/*", "config/**/*", "reporters/**/*", "playwright.config.ts"],
  "exclude": ["node_modules"]
}